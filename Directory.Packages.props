<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- AI & LLM -->
    <PackageVersion Include="Anthropic.SDK" Version="5.8.0" />

    <!-- PDF Generation -->
    <PackageVersion Include="QuestPDF" Version="2025.12.1" />
    <PackageVersion Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageVersion Include="SkiaSharp" Version="3.119.1" />

    <!-- Redis -->
    <PackageVersion Include="StackExchange.Redis" Version="2.9.17" />
    <PackageVersion Include="NRedisStack" Version="1.2.0" />

    <!-- Document Processing -->
    <PackageVersion Include="NPOI" Version="2.7.5" />

    <!-- Configuration -->
    <PackageVersion Include="DotNetEnv" Version="3.1.1" />
  </ItemGroup>
</Project>
